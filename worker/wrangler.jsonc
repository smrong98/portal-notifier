{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-notifier",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "PORTAL_KV",
      "id": "c88fe3d38af4494a82563cd2a15da922"
    }
  ],

  "services": [
    {
      "binding": "MEAL_APP",
      "service": "meal-notifier",
      "entrypoint": "MealPublisher"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * SAT"
    ]
  },

  "vars": {
    "PORTAL_BASE_URL": "https://dnsep.dncompany.com",
    "PORTAL_LOGIN_URL": "https://dnsep.dncompany.com/ldloginproc.do",
    "PORTAL_BOARD_API_URL": "https://dnsep.dncompany.com/board/selectBoardTopFive.do",
    // 주간 PDF URL을 고정 배포할 때 설정합니다. API 요청의 pdfUrl로도 전달할 수 있습니다.
    "MEAL_PDF_URL": "https://dnsep.dncompany.com/privatefiles/public/CN99999/board/7dbe6683-5659-49c3-adee-20a5bc5ba0dc/b997b7eb-5660-4d9d-95b9-3da4d7e7d89c.pdf",
    "APP_URL": "https://smrong98.github.io/portal-notifier/",
    "ALLOWED_ORIGIN": "https://smrong98.github.io"
  },

  "secrets": {
    "required": [
      "PORTAL_USERNAME",
      "PORTAL_PASSWORD",
      "CLIENT_KEY",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "VAPID_SUBJECT"
    ]
  },

  "observability": { "enabled": true }
}
