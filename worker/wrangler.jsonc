{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portal-notifier",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "PORTAL_KV",
      "id": "c88fe3d38af4494a82563cd2a15da922"
    }
  ],

  "services": [
    {
      "binding": "MEAL_APP",
      "service": "meal-notifier",
      "entrypoint": "MealPublisher"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * SAT"
    ]
  },

  "vars": {
    "PORTAL_BASE_URL": "https://dnsep.dncompany.com",
    "PORTAL_LOGIN_URL": "https://dnsep.dncompany.com/ldloginproc.do",
    "PORTAL_BOARD_API_URL": "https://dnsep.dncompany.com/board/selectBoardTopFive.do",
    // 식단 게시판의 최신 글에서 PDF 첨부파일을 자동으로 찾습니다.
    "MEAL_BOARDMST_ID": "f2aff21d-d839-5cb4-5dcf-76a91a1c1627",
    "APP_URL": "https://smrong98.github.io/portal-notifier/",
    "ALLOWED_ORIGIN": "https://smrong98.github.io"
  },

  "secrets": {
    "required": [
      "PORTAL_USERNAME",
      "PORTAL_PASSWORD",
      "CLIENT_KEY",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "VAPID_SUBJECT"
    ]
  },

  "observability": { "enabled": true }
}
