{
  "name": "meal-notifier-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "check": "npm test && wrangler deploy --dry-run",
    "test": "node --test",
    "types": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply meal-notifier-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meal-notifier-db --remote",
    "vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^26.2.0",
    "wrangler": "^4.120.0"
  }
}
